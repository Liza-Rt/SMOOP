<Window x:Class="RubellitaHotelAdmin.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Готель «Rubellita» — Вхід до системи"
        Icon="pack://application:,,,/Assets/logo.png"
        Height="640" Width="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCreamBrush}">
    <Grid Margin="20">
        <Border Background="White" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2"
                CornerRadius="12" Padding="24">
            <StackPanel VerticalAlignment="Center">
                <!-- Логотип та назва готелю Rubellita (#aa1945 та #f5e8aa) -->
                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="{StaticResource AccentCreamBrush}" CornerRadius="48" Padding="3" Margin="0,0,0,8"
                                HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="84" Height="84"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="RUBELLITA" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource AccentCreamBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="ПАНЕЛЬ АДМІНІСТРАТОРА ГОТЕЛЮ" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentCreamBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Вхід в обліковий запис" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

                <TextBlock Text="Обліковий запис адміністратора (з admins.json):" FontWeight="SemiBold"
                           Foreground="#2A1219" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Admins}" SelectedItem="{Binding SelectedAdmin}"
                          DisplayMemberPath="DisplayTitle" Height="34" Margin="0,0,0,12"/>

                <TextBlock Text="Код доступу:" FontWeight="SemiBold" Foreground="#2A1219" Margin="0,0,0,4"/>
                <PasswordBox x:Name="AccessCodeBox" Height="34" Padding="6,4" FontSize="14"
                             Foreground="#2A1219" BorderBrush="{StaticResource BorderCreamBrush}" BorderThickness="1.5"
                             PasswordChanged="AccessCodeBox_PasswordChanged" Margin="0,0,0,10"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B71C1C" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                <Button Content="Увійти до системи" Command="{Binding LoginCommand}" IsDefault="True"
        Style="{StaticResource PrimaryButtonStyle}" Height="38" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
