<Window x:Class="RubellitaHotelAdmin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:RubellitaHotelAdmin.Helpers"
        Title="Готель «Rubellita» — Автоматизоване робоче місце адміністратора"
        Icon="pack://application:,,,/Assets/logo.png"
        Height="800" Width="1300"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCreamBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Верхня шапка готелю Rubellita (#aa1945 + #f5e8aa) -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Background="{StaticResource AccentCreamBrush}" CornerRadius="26" Padding="2" Margin="0,0,14,0">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="46" Height="46"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Готель «Rubellita» — Система управління готелем" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentCreamBrush}"/>
                        <TextBlock Text="Номерний фонд • Бронювання • План поверхів • Лояльність та аналітика"
                                   FontSize="11.5" Foreground="{StaticResource AccentCreamBrush}" Opacity="0.92"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Border Background="{StaticResource PrimaryDarkBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Адміністратор: " Foreground="{StaticResource AccentCreamBrush}" Opacity="0.9"/>
                            <TextBlock Text="{Binding CurrentAdmin.FullName}" FontWeight="Bold" Foreground="{StaticResource AccentCreamBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Вийти" Click="LogoutButton_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Головний TabControl з двосторонньою прив'язкою SelectedIndex між вкладками -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Margin="12"
                    Background="White"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="1.5">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,9"/>
                    <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
                    <Setter Property="Background" Value="{StaticResource AccentCreamBrush}"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1,1,1,0"
                                        CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentCreamBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Стиль для елементів ListBox на карті поверху (без стандартного синього виділення Windows, з центруванням) -->
                <Style x:Key="FloorRoomListBoxItemStyle" TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="6,4"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="SelectionFrame" CornerRadius="10" Padding="2" BorderThickness="2.5" BorderBrush="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="#AA1945"/>
                                        <Setter TargetName="SelectionFrame" Property="Background" Value="#FFF8E1"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SelectionFrame" Property="Opacity" Value="0.93"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ВКЛАДКА 1: ПЛАН ПОВЕРХІВ -->
            <TabItem Header="🏢 План поверхів">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Схема поверху з крилами, кутовими кімнатами та коридором -->
                    <Border Grid.Column="0" Background="{StaticResource BgCreamBrush}" BorderBrush="{StaticResource BorderCreamBrush}"
                            BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="54"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Панель вибору поверху та легенда підсвітки -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Оберіть поверх:" FontWeight="Bold" FontSize="14" Foreground="#2A1219" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ListBox ItemsSource="{Binding AvailableFloors}" SelectedItem="{Binding SelectedFloor}"
                                             Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,5" Margin="0,0,6,0" CornerRadius="6"
                                                        Background="{StaticResource AccentCreamBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1.5">
                                                    <TextBlock Text="{Binding StringFormat='{}{0}-й поверх'}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <!-- Легенда кольорів статусів -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#E8F5E9" BorderBrush="#2E7D32" BorderThickness="1.5" CornerRadius="5" Padding="8,3" Margin="4,0">
                                        <TextBlock Text="● Вільний" Foreground="#2E7D32" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <Border Background="#FFF3E0" BorderBrush="#EF6C00" BorderThickness="1.5" CornerRadius="5" Padding="8,3" Margin="4,0">
                                        <TextBlock Text="● Заброньований" Foreground="#EF6C00" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <Border Background="#FCE4EC" BorderBrush="#AA1945" BorderThickness="1.5" CornerRadius="5" Padding="8,3" Margin="4,0">
                                        <TextBlock Text="● Зайнятий" Foreground="#AA1945" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <!-- Ліве крило кімнат (блок відцентрований) -->
                            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" BorderBrush="{StaticResource BorderCreamBrush}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="◀ ЛІВЕ КРИЛО (Фасад / Сад)" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding FloorLeftWingRooms}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectMapRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" Padding="0" Margin="6,4" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Border x:Name="OuterSelectFrame" CornerRadius="10" Padding="3" BorderThickness="2.5" BorderBrush="Transparent">
                                                        <Border Background="{Binding Status, Converter={StaticResource StatusToBgConverter}}"
                                                                BorderBrush="{Binding Status, Converter={StaticResource StatusToFgConverter}}"
                                                                BorderThickness="2" CornerRadius="8" Padding="12,10" MinWidth="195">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <DockPanel>
                                                                    <TextBlock Text="{Binding RoomNumber, StringFormat='№ {0}'}" FontSize="18" FontWeight="Bold"
                                                                               Foreground="{Binding Status, Converter={StaticResource StatusToFgConverter}}"/>
                                                                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="4" Padding="6,2"
                                                                            HorizontalAlignment="Right"
                                                                            Visibility="{Binding IsCorner, Converter={StaticResource BoolToVisConverter}}">
                                                                        <TextBlock Text="КУТОВИЙ" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentCreamBrush}"/>
                                                                    </Border>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Type}" FontSize="12" FontWeight="SemiBold" Foreground="#2A1219" TextWrapping="Wrap" Margin="0,4,0,2"/>
                                                                <TextBlock Text="{Binding CapacityLabel}" FontSize="11.5" FontWeight="Medium" Foreground="#4A2E36"/>
                                                                <TextBlock Text="{Binding PricePerNight, StringFormat='{}{0:N0} грн/доба'}" FontSize="12.5" FontWeight="Bold" Foreground="#2A1219" Margin="0,4,0,2"/>
                                                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold"
                                                                           Foreground="{Binding Status, Converter={StaticResource StatusToFgConverter}}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Border>
                                                </Button>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                <Binding Path="."/>
                                                                <Binding Path="DataContext.SelectedMapRoom" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter TargetName="OuterSelectFrame" Property="BorderBrush" Value="#AA1945"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>

                            <!-- Центральний коридор + Ліфт / Сходи -->
                            <Border Grid.Row="2" Background="{StaticResource PrimaryBrush}" CornerRadius="6" Margin="0,8">
                                <Grid>
                                    <TextBlock Text="═══   ГОЛОВНИЙ КОРИДОР ПОВЕРХУ   •   ЛІФТ ТА СХОДИ   •   СЛУЖБОВИЙ ХОЛ   ═══"
                                               Foreground="{StaticResource AccentCreamBrush}" FontWeight="Bold" FontSize="12.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Праве крило кімнат (блок відцентрований) -->
                            <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10" BorderBrush="{StaticResource BorderCreamBrush}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="ПРАВЕ КРИЛО (Внутрішній дворик / Тераса) ▶" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding FloorRightWingRooms}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectMapRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" Padding="0" Margin="6,4" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Border x:Name="OuterSelectFrame" CornerRadius="10" Padding="3" BorderThickness="2.5" BorderBrush="Transparent">
                                                        <Border Background="{Binding Status, Converter={StaticResource StatusToBgConverter}}"
                                                                BorderBrush="{Binding Status, Converter={StaticResource StatusToFgConverter}}"
                                                                BorderThickness="2" CornerRadius="8" Padding="12,10" MinWidth="195">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <DockPanel>
                                                                    <TextBlock Text="{Binding RoomNumber, StringFormat='№ {0}'}" FontSize="18" FontWeight="Bold"
                                                                               Foreground="{Binding Status, Converter={StaticResource StatusToFgConverter}}"/>
                                                                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="4" Padding="6,2"
                                                                            HorizontalAlignment="Right"
                                                                            Visibility="{Binding IsCorner, Converter={StaticResource BoolToVisConverter}}">
                                                                        <TextBlock Text="КУТОВИЙ" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentCreamBrush}"/>
                                                                    </Border>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Type}" FontSize="12" FontWeight="SemiBold" Foreground="#2A1219" TextWrapping="Wrap" Margin="0,4,0,2"/>
                                                                <TextBlock Text="{Binding CapacityLabel}" FontSize="11.5" FontWeight="Medium" Foreground="#4A2E36"/>
                                                                <TextBlock Text="{Binding PricePerNight, StringFormat='{}{0:N0} грн/доба'}" FontSize="12.5" FontWeight="Bold" Foreground="#2A1219" Margin="0,4,0,2"/>
                                                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold"
                                                                           Foreground="{Binding Status, Converter={StaticResource StatusToFgConverter}}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Border>
                                                </Button>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                <Binding Path="."/>
                                                                <Binding Path="DataContext.SelectedMapRoom" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter TargetName="OuterSelectFrame" Property="BorderBrush" Value="#AA1945"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Права картка обраного на плані номера (Пункт 5: максимально чіткий висококонтрастний текст!) -->
                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Інформація про обраний номер" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

                            <Border Background="#FFFDF4" BorderBrush="#E4D284" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedMapRoom.RoomNumber, StringFormat='Кімната № {0}'}" FontSize="22" FontWeight="Bold" Foreground="#AA1945"/>
                                    <TextBlock Text="{Binding SelectedMapRoom.Type}" FontSize="14.5" FontWeight="Bold" Foreground="#2A1219" Margin="0,6,0,4"/>
                                    <TextBlock Text="{Binding SelectedMapRoom.Wing, StringFormat='Розташування: {0}'}" FontSize="13.5" FontWeight="SemiBold" Foreground="#2A1219" Margin="0,2"/>
                                    <TextBlock Text="{Binding SelectedMapRoom.CornerLabel, StringFormat='Тип планування: {0}'}" FontSize="13.5" FontWeight="SemiBold" Foreground="#2A1219" Margin="0,2"/>
                                    <TextBlock Text="{Binding SelectedMapRoom.CapacityLabel, StringFormat='Місткість: {0}'}" FontSize="13.5" FontWeight="SemiBold" Foreground="#2A1219" Margin="0,2"/>
                                    <TextBlock Text="{Binding SelectedMapRoom.PricePerNight, StringFormat='Тариф: {0:N2} грн / доба'}" FontSize="14" FontWeight="Bold" Foreground="#2A1219" Margin="0,3"/>
                                    <TextBlock Text="{Binding SelectedMapRoom.Status, StringFormat='Поточний статус: {0}'}" FontSize="14" FontWeight="Bold"
                                               Foreground="{Binding SelectedMapRoom.Status, Converter={StaticResource StatusToFgConverter}}" Margin="0,5,0,3"/>
                                    <TextBlock Text="{Binding SelectedMapRoom.Description}" TextWrapping="Wrap" FontSize="12.5" FontWeight="Medium" Foreground="#3D222A" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Дані про поточного гостя в номері -->
                            <Border Background="{StaticResource AccentCreamBrush}" BorderBrush="#D8C068" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Поточний / найближчий гість:" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedMapRoomBooking.GuestFullName, TargetNullValue='Номер наразі вільний від гостей'}"
                                               FontWeight="Bold" FontSize="13.5" Foreground="#2A1219" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedMapRoomBooking.FullPhoneDisplay}" FontSize="12.5" FontWeight="SemiBold" Foreground="#2A1219" Margin="0,3"/>
                                    <TextBlock Text="{Binding SelectedMapRoomBooking.CheckInDateTimeDisplay, StringFormat='Заїзд: {0}'}" FontSize="12.5" FontWeight="SemiBold" Foreground="#2A1219"/>
                                    <TextBlock Text="{Binding SelectedMapRoomBooking.CheckOutDateTimeDisplay, StringFormat='Виїзд: {0}'}" FontSize="12.5" FontWeight="SemiBold" Foreground="#2A1219"/>
                                </StackPanel>
                            </Border>

                            <Button Content="📅 Оформити бронювання на цей номер"
                                    Command="{Binding BookSelectedMapRoomCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="38"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 2: НОМЕРНИЙ ФОНД -->
            <TabItem Header="🛏 Номерний фонд">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель пошуку, фільтрації та сортування -->
                    <Border Grid.Row="0" Background="{StaticResource BgCreamBrush}" BorderBrush="{StaticResource BorderCreamBrush}"
                            BorderThickness="1.5" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Margin="0,0,10,4">
                                <TextBlock Text="Пошук (номер / опис):" FontSize="11.5" Foreground="#821133" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding RoomSearchText, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="30"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,10,4">
                                <TextBlock Text="Статус:" FontSize="11.5" Foreground="#821133" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding FilterStatus}" Width="135" Height="30"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,10,4">
                                <TextBlock Text="Тип номера:" FontSize="11.5" Foreground="#821133" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding TypeFilterOptions}" SelectedItem="{Binding FilterType}" Width="185" Height="30"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,10,4">
                                <TextBlock Text="Місткість:" FontSize="11.5" Foreground="#821133" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding CapacityFilterOptions}" SelectedItem="{Binding FilterCapacity}" Width="115" Height="30"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,10,4">
                                <TextBlock Text="Макс. ціна (грн):" FontSize="11.5" Foreground="#821133" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding FilterMaxPrice, UpdateSourceTrigger=PropertyChanged}" Width="105" Height="30"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,10,4">
                                <TextBlock Text="Сортування:" FontSize="11.5" Foreground="#821133" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding RoomSortOptions}" SelectedItem="{Binding RoomSortOption}" Width="195" Height="30"/>
                            </StackPanel>

                            <Button Content="Скинути фільтри" Command="{Binding ClearRoomFiltersCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="30" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </WrapPanel>
                    </Border>

                    <!-- Таблиця номерів + картка перегляду інформації про обраний номер (без додавання/редагування) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.15*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0" ItemsSource="{Binding FilteredRoomsView}" SelectedItem="{Binding SelectedRoom}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  RowHeight="36" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,0,12,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding RoomNumber}" Width="55"/>
                                <DataGridTextColumn Header="Поверх" Binding="{Binding Floor}" Width="65"/>
                                <DataGridTextColumn Header="Крило" Binding="{Binding Wing}" Width="105"/>
                                <DataGridTextColumn Header="Тип номера" Binding="{Binding Type}" Width="190"/>
                                <DataGridTextColumn Header="Місткість" Binding="{Binding CapacityLabel}" Width="90"/>
                                <DataGridTextColumn Header="Кутовий" Binding="{Binding CornerLabel}" Width="80"/>
                                <DataGridTextColumn Header="Ціна / доба" Binding="{Binding PricePerNight, StringFormat='{}{0:N0} грн'}" Width="105"/>
                                <DataGridTemplateColumn Header="Статус" Width="125">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource StatusToBgConverter}}"
                                                    CornerRadius="4" Padding="6,2" Margin="4,2">
                                                <TextBlock Text="{Binding Status}" FontWeight="Bold" HorizontalAlignment="Center"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToFgConverter}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Права панель виключно для перегляду інформації про номер -->
                        <Border Grid.Column="1" Background="#FFFDF4" BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="1.5" CornerRadius="10" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Перегляд інформації про номер" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

                                    <Border Background="White" BorderBrush="#E4D284" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedRoom.RoomNumber, StringFormat='Кімната № {0}'}" FontSize="22" FontWeight="Bold" Foreground="#AA1945"/>
                                            <TextBlock Text="{Binding SelectedRoom.Type}" FontSize="14.5" FontWeight="Bold" Foreground="#2A1219" Margin="0,6,0,4"/>
                                            <TextBlock Text="{Binding SelectedRoom.Floor, StringFormat='Поверх: {0}'}" FontSize="13.5" FontWeight="SemiBold" Foreground="#2A1219" Margin="0,2"/>
                                            <TextBlock Text="{Binding SelectedRoom.Wing, StringFormat='Розташування: {0}'}" FontSize="13.5" FontWeight="SemiBold" Foreground="#2A1219" Margin="0,2"/>
                                            <TextBlock Text="{Binding SelectedRoom.CornerLabel, StringFormat='Планування: {0}'}" FontSize="13.5" FontWeight="SemiBold" Foreground="#2A1219" Margin="0,2"/>
                                            <TextBlock Text="{Binding SelectedRoom.CapacityLabel, StringFormat='Місткість: {0}'}" FontSize="13.5" FontWeight="SemiBold" Foreground="#2A1219" Margin="0,2"/>
                                            <TextBlock Text="{Binding SelectedRoom.PricePerNight, StringFormat='Тариф: {0:N2} грн / доба'}" FontSize="14" FontWeight="Bold" Foreground="#2A1219" Margin="0,4"/>
                                            <TextBlock Text="{Binding SelectedRoom.Status, StringFormat='Поточний статус: {0}'}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{Binding SelectedRoom.Status, Converter={StaticResource StatusToFgConverter}}" Margin="0,4,0,4"/>
                                            <TextBlock Text="{Binding SelectedRoom.Description}" TextWrapping="Wrap" FontSize="12.5" FontWeight="Medium" Foreground="#2A1219" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="📅 Перейти до бронювання цього номера"
                                            Command="{Binding BookSelectedMapRoomCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" Height="36"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 3: БРОНЮВАННЯ ТА ПОСЕЛЕННЯ (ЛИШЕ ЗАБРОНЬОВАНІ ТА АКТИВНІ!) -->
            <TabItem Header="📅 Бронювання та поселення">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.85*"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ліва частина: пошук та активні/заброньовані записи -->
                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <Border DockPanel.Dock="Top" Background="{StaticResource BgCreamBrush}" BorderBrush="{StaticResource BorderCreamBrush}"
                                BorderThickness="1.5" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="🔍 Пошук серед активних та заброньованих:" FontWeight="Bold" Foreground="#821133" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Text="{Binding BookingSearchText, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                                </DockPanel>
                                <TextBlock Text="ℹ Тут відображаються лише заброньовані та активні проживання. Завершені бронювання автоматично переносяться до розділу «Статистика»."
                                           FontSize="11.5" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid ItemsSource="{Binding FilteredBookingsView}" SelectedItem="{Binding SelectedBooking}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  RowHeight="36" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding RoomNumber}" Width="50"/>
                                <DataGridTextColumn Header="ПІБ Гостя" Binding="{Binding GuestFullName}" Width="180"/>
                                <DataGridTemplateColumn Header="Телефон" Width="165" SortMemberPath="PhoneNumber">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="2" BorderBrush="#B9A86A" BorderThickness="1" Margin="4,0,7,0"
                                                        Width="24" Height="16" ClipToBounds="True" SnapsToDevicePixels="True">
                                                    <Image Source="{Binding CountryShortCode, Converter={StaticResource FlagConverter}}" Stretch="Fill"/>
                                                </Border>
                                                <TextBlock Text="{Binding DialCode}" FontWeight="SemiBold" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FormattedPhone}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Заселення" Binding="{Binding CheckInDateTimeDisplay}" Width="118"/>
                                <DataGridTextColumn Header="Виїзд" Binding="{Binding CheckOutDateTimeDisplay}" Width="118"/>
                                <DataGridTextColumn Header="Діб" Binding="{Binding NightsCount}" Width="42"/>
                                <!-- Пункт 6: тільки відсоток знижки -->
                                <DataGridTextColumn Header="Знижка" Binding="{Binding DiscountLabel}" Width="68"/>
                                <DataGridTextColumn Header="Сума" Binding="{Binding TotalCost, StringFormat='{}{0:N0} грн'}" Width="92"/>
                                <DataGridTextColumn Header="Стан" Binding="{Binding BookingState}" Width="135"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Права частина: картка оформлення / редагування бронювання -->
                    <Border Grid.Column="1" Background="{StaticResource BgCreamBrush}" BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="1.5" CornerRadius="10" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Оформлення бронювання" FontSize="16" FontWeight="Bold" Foreground="#821133"/>
                                    <Button Content="Очистити" Command="{Binding ClearBookingFormCommand}" HorizontalAlignment="Right"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" FontSize="11.5"/>
                                </DockPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Номер кімнати:" FontWeight="Bold" Foreground="#c43560" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding Rooms}" DisplayMemberPath="RoomNumber"
                                                  SelectedValuePath="RoomNumber" SelectedValue="{Binding BookingRoomNumber}" Height="30"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Статус бронювання:" FontWeight="Bold" Foreground="#c43560" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding BookingStatesList}" SelectedItem="{Binding SelectedBookingState}" Height="30"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="ПІБ гостя (обов'язково):" FontWeight="Bold" Foreground="#c43560" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding GuestFullName, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,8"/>

                                <!-- Пункт 1 і 2: Випадаючий список країн з прапорами + обмеження вводу кількості цифр для країни -->
                                <TextBlock FontWeight="Bold" Foreground="#2A1219">
                                    <Run Text="Телефон гостя (ліміт цифр для країни: " Foreground="#c43560"/>
                                    <Run Text="{Binding MaxPhoneDigits, Mode=OneWay}" FontWeight="Bold" Foreground="#AA1945"/>
                                    <Run Text="):" Foreground="#c43560"/>
                                </TextBlock>
                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding CountryCodes}" SelectedItem="{Binding SelectedCountryCode}" Height="34">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1">
                                                    <!-- Власний векторний прапор країни (Resources/Flags.xaml) -->
                                                    <Border CornerRadius="3" BorderBrush="#B9A86A" BorderThickness="1" Margin="0,0,9,0"
                                                            Width="32" Height="22" ClipToBounds="True" SnapsToDevicePixels="True">
                                                        <Image Source="{Binding ShortCode, Converter={StaticResource FlagConverter}}" Stretch="Fill"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding CountryName}" FontSize="12.5" Foreground="#2A1219" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Border Background="#F5E8AA" CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DialCode}" FontSize="12" FontWeight="Bold" Foreground="#AA1945"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid Grid.Column="2">
                                        <TextBox Text="{Binding GuestPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                                 helpers:PhoneInputBehavior.MaxDigits="{Binding MaxPhoneDigits}"
                                                 Height="32"/>
                                        <!-- Сіра маска кількості цифр відповідно до обраної країни -->
                                        <TextBlock Text="{Binding PhoneWatermarkText}" Foreground="#5A464C" FontWeight="SemiBold"
                                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Visibility="{Binding ShowPhonePlaceholder, Converter={StaticResource BoolToVisConverter}}"/>
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Паспорт / ID-картка:" FontWeight="Bold" Foreground="#c43560" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding GuestPassport}" Height="30"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="E-mail гостя:" FontWeight="Bold" Foreground="#c43560" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding GuestEmail}" Height="30"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Додаткова інформація про гостя (побажання, авто, VIP):" FontWeight="Bold" Foreground="#c43560" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding GuestNotes}" Height="38" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Пункт 7: Дата ТА ЧАС заїзду і виїзду для уникнення конфліктів -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Дата заселення:" FontWeight="Bold" Foreground="#c43560" Margin="0,0,0,2"/>
                                        <DatePicker SelectedDate="{Binding CheckInDate}" Height="30"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Час заїзду:" FontWeight="Bold" Foreground="#c43560" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding AvailableTimeSlots}" SelectedItem="{Binding SelectedCheckInTime}" Height="30"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Дата виїзду:" FontWeight="Bold" Foreground="#c43560" Margin="0,0,0,2"/>
                                        <DatePicker SelectedDate="{Binding CheckOutDate}" Height="30"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Час виїзду:" FontWeight="Bold" Foreground="#c43560" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding AvailableTimeSlots}" SelectedItem="{Binding SelectedCheckOutTime}" Height="30"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Блок автоматичного розрахунку вартості та знижки за кожне 5-те заселення -->
                                <Border Background="White" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1.5" CornerRadius="8" Padding="10" Margin="0,2,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LoyaltyStatusMessage}" Foreground="{StaticResource PrimaryBrush}"
                                                   FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <TextBlock Text="{Binding CalculatedNights, StringFormat='Тривалість: {0} діб'}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CalculatedDiscountPercent, StringFormat='Знижка: {0:0}%'}"
                                                       HorizontalAlignment="Right" FontWeight="Bold" Foreground="#2E7D32"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding CalculatedTotalPrice, StringFormat='До сплати: {0:N2} грн'}"
                                                   FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Button Content="✔ Створити бронювання / Заселити" Command="{Binding CreateBookingCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="34" Margin="0,0,0,5"/>
                                <Button Content="💾 Оновити обране бронювання" Command="{Binding UpdateBookingCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Height="32" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🏁 Виселити (Завершити)" Command="{Binding CompleteBookingCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" Height="32" FontSize="11.5"/>
                                    <Button Grid.Column="2" Content="✖ Скасувати бронь" Command="{Binding CancelBookingCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" Height="32" FontSize="11.5"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 4: БАЗА ГОСТЕЙ ТА СИСТЕМА ЗНИЖОК -->
            <TabItem Header="👥 Гості та програма лояльності">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgCreamBrush}" BorderBrush="{StaticResource BorderCreamBrush}"
                            BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔍 Пошук гостя (ПІБ, телефон, паспорт):" FontWeight="Bold" Foreground="#821133" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Text="{Binding GuestSearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="260" Height="32"/>
                            </StackPanel>

                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{StaticResource PrimaryBrush}" CornerRadius="6" Padding="12,6">
                                <TextBlock Text="🎁 Правило лояльності: кожне 5-те заселення гостя – знижка 20%!"
                                           Foreground="{StaticResource AccentCreamBrush}" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding GuestSummaries}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              RowHeight="36" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ПІБ Гостя" Binding="{Binding GuestFullName}" Width="210"/>
                            <DataGridTextColumn Header="Контактний телефон" Binding="{Binding PhoneDisplay}" Width="180"/>
                            <DataGridTextColumn Header="Паспорт / ID" Binding="{Binding PassportOrId}" Width="110"/>
                            <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="165"/>
                            <DataGridTextColumn Header="Кількість візитів" Binding="{Binding StaysCount}" Width="125"/>
                            <DataGridTextColumn Header="Останній заїзд" Binding="{Binding LastCheckIn, StringFormat='{}{0:dd.MM.yyyy}'}" Width="110"/>
                            <DataGridTextColumn Header="Останній виїзд" Binding="{Binding LastCheckOut, StringFormat='{}{0:dd.MM.yyyy}'}" Width="110"/>
                            <DataGridTextColumn Header="Статус знижки" Binding="{Binding NextDiscountInfo}" Width="230"/>
                            <DataGridTemplateColumn Header="Дія" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="+ Заселити знову"
                                                Command="{Binding DataContext.BookForSelectedGuestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButtonStyle}" Padding="6,2" Margin="4,2" FontSize="11.5"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 5: СТАТИСТИКА ТА ЖУРНАЛ ЗАЇЗДІВ/ВИЇЗДІВ (ТУТ ПЕРЕГЛЯДАЮТЬСЯ ЗАВЕРШЕНІ БРОНЮВАННЯ) -->
            <TabItem Header="📊 Статистика та звітність">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Фільтр періоду та стану (включно із завершеними) -->
                    <Border Grid.Row="0" Background="{StaticResource BgCreamBrush}" BorderBrush="{StaticResource BorderCreamBrush}"
                            BorderThickness="1.5" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Період розрахунку:   З" FontWeight="Bold" Foreground="#821133" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker SelectedDate="{Binding StatsStartDate}" Width="135" Height="30"/>
                            <TextBlock Text="ПО" FontWeight="Bold" Foreground="#821133" VerticalAlignment="Center" Margin="10,0"/>
                            <DatePicker SelectedDate="{Binding StatsEndDate}" Width="135" Height="30"/>
                            <TextBlock Text="Показати записи:" FontWeight="Bold" Foreground="#821133" VerticalAlignment="Center" Margin="20,0,8,0"/>
                            <ComboBox ItemsSource="{Binding StatsStateFilterOptions}" SelectedItem="{Binding StatsStateFilter}" Width="235" Height="30"/>
                        </StackPanel>
                    </Border>

                    <!-- Картки ключових показників (KPI) -->
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Заповненість готелю" Foreground="{StaticResource AccentCreamBrush}" Opacity="0.95" FontSize="13"/>
                                <TextBlock Text="{Binding OccupancyRatePercent, StringFormat='{}{0}%'}" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource AccentCreamBrush}" Margin="0,4"/>
                                <TextBlock Foreground="{StaticResource AccentCreamBrush}" FontSize="12">
                                    <Run Text="Зайнято:"/>
                                    <Run Text="{Binding OccupiedRoomsCount}"/>
                                    <Run Text="| Бронь:"/>
                                    <Run Text="{Binding BookedRoomsCount}"/>
                                    <Run Text="| Вільні:"/>
                                    <Run Text="{Binding FreeRoomsCount}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Активні / Завершені" Foreground="{StaticResource MutedTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4">
                                    <Run Text="{Binding ActiveBookingsCount}"/>
                                    <Run Text=" / " Foreground="#6E535B"/>
                                    <Run Text="{Binding CompletedBookingsCount}" Foreground="#2E7D32"/>
                                </TextBlock>
                                <TextBlock Text="Поточні та завершені візити" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Дохід за обраний період" Foreground="{StaticResource MutedTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PeriodRevenue, StringFormat='{}{0:N2} грн'}" FontSize="24" FontWeight="Bold"
                                           Foreground="#2E7D32" Margin="0,6"/>
                                <TextBlock Text="З урахуванням знижок лояльності" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource AccentCreamBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Загальний номерний фонд" Foreground="{StaticResource DarkTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalRoomsCount, StringFormat='{}{0} номерів'}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,4"/>
                                <TextBlock Text="3 поверхи • Ліве та Праве крило" Foreground="{StaticResource DarkTextBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Детальна таблиця: хто, коли заїхав і виїхав (включно із завершеними бронюваннями) -->
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="📋 Історія та графік заїздів і виїздів гостей за період (включно із завершеними):"
                                   FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>

                        <DataGrid ItemsSource="{Binding PeriodMovementBookings}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  RowHeight="36" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding RoomNumber}" Width="55"/>
                                <DataGridTextColumn Header="ПІБ Гостя" Binding="{Binding GuestFullName}" Width="205"/>
                                <DataGridTemplateColumn Header="Телефон" Width="165" SortMemberPath="PhoneNumber">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="2" BorderBrush="#B9A86A" BorderThickness="1" Margin="4,0,7,0"
                                                        Width="24" Height="16" ClipToBounds="True" SnapsToDevicePixels="True">
                                                    <Image Source="{Binding CountryShortCode, Converter={StaticResource FlagConverter}}" Stretch="Fill"/>
                                                </Border>
                                                <TextBlock Text="{Binding DialCode}" FontWeight="SemiBold" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FormattedPhone}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Заїзд (дата і час)" Binding="{Binding CheckInDateTimeDisplay}" Width="130"/>
                                <DataGridTextColumn Header="Виїзд (дата і час)" Binding="{Binding CheckOutDateTimeDisplay}" Width="130"/>
                                <DataGridTextColumn Header="Діб" Binding="{Binding NightsCount}" Width="48"/>
                                <DataGridTextColumn Header="Візит №" Binding="{Binding VisitNumber}" Width="70"/>
                                <DataGridTextColumn Header="Знижка" Binding="{Binding DiscountLabel}" Width="75"/>
                                <DataGridTextColumn Header="Сплачено" Binding="{Binding TotalCost, StringFormat='{}{0:N2} грн'}" Width="115"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding BookingState}" Width="145"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

